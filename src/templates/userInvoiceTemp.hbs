<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Invoice - {{invoiceId}}</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            color: #333;
        }

        .container {
            max-width: 600px;
            margin: 0 auto;
            padding: 20px;
            border: 1px solid #eee;
        }

        h1 {
            color: #8b6a3f;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }

        th,
        td {
            padding: 10px;
            border: 1px solid #000000;
            text-align: left;
        }

        th {
            background-color: #ffffff;
        }

        .total {
            font-weight: bold;
            font-size: 1.2em;
        }

        .footer {
            margin-top: 30px;
            font-size: 0.9em;
            color: #777;
        }
    </style>
</head>

<body>
    <div class="container">
        <h1>Invoice: {{invoiceId}}</h1>
        <p>Hi {{firstName}} {{lastName}},</p>
        <p>Thank you for booking with us. Here are your invoice details:</p>

        <table>
            <tr>
                <th>Property</th>
                <td>{{propertyName}}</td>
            </tr>
            <tr>
                <th>Rooms</th>
                <td>{{#each roomsName}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</td>
            </tr>
            <tr>
                <th>Booking Dates</th>
                <td>{{bookingDate.startDate}} - {{bookingDate.endDate}}</td>
            </tr>
            <tr>
                <th>Amount</th>
                <td>${{amount}}</td>
            </tr>
            <tr>
                <th>Status</th>
                <td>{{status}}</td>
            </tr>
        </table>

        <p class="total">Total: ${{amount}}</p>

        <div class="footer">
            <p>If you have any questions, please contact support at <a
                    href="mailto:support@yourdomain.com">support@yourdomain.com</a>.</p>
        </div>
    </div>
</body>

</html>